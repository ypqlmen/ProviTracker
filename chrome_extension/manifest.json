{
  "manifest_version": 3,
  "name": "Provi Tracker – Masterark",
  "version": "0.1.0",
  "description": "Forbind Provi Tracker med dit åbne masterark. Prototype: kontrollerer kun forbindelsen.",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging", "alarms"],
  "host_permissions": ["https://5rmarketing-my.sharepoint.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://5rmarketing-my.sharepoint.com/*"], "js": ["probe.js"], "all_frames": true}],
  "key": ""
}
